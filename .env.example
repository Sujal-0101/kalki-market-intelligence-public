# Copy this file to .env for local overrides. Never commit .env.
KALKI_ENVIRONMENT=development
KALKI_LOG_LEVEL=INFO
KALKI_DATA_DIR=data
KALKI_TIMEZONE=UTC
# Required only for live SEC ingestion. Use your application name and contact email.
KALKI_SEC_USER_AGENT="Kalki Market Intelligence your-email@example.com"
KALKI_SEC_REQUESTS_PER_SECOND=2
KALKI_SEC_TIMEOUT_SECONDS=30
KALKI_SEC_MAXIMUM_RESPONSE_BYTES=50000000
# Discord remains disabled unless explicitly enabled with a secret stored only in local .env.
KALKI_DISCORD_ENABLED=false
# KALKI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
KALKI_DISCORD_REQUESTS_PER_SECOND=0.5
KALKI_DISCORD_TIMEOUT_SECONDS=10
KALKI_DISCORD_MAXIMUM_RESPONSE_BYTES=100000
KALKI_DISCORD_MAXIMUM_ATTEMPTS=3
# The filing radar is off in development. Production Compose supplies these values.
KALKI_WORKER_ENABLED=false
KALKI_WORKER_POLL_SECONDS=900
KALKI_WORKER_BATCH_SIZE=2
KALKI_WORKER_MODEL=qwen3:4b
KALKI_WORKER_MODEL_DIGEST=359d7dd4bcdab3d86b87d73ac27966f4dbb9f5efdfcc75d34a8764a09474fae7
# Production enables this only after local Gemma 4 qualification and migration 0005.
KALKI_WORKER_VERIFIER_ENABLED=false
KALKI_WORKER_VERIFIER_MODEL=gemma4:12b-it-q4_K_M
KALKI_WORKER_VERIFIER_MODEL_DIGEST=4eb23ef187e2c5462566d6a1d3bbbc2f1346d0b4327cbb66d58fffbcc9b2b05c
# Supporting price outcomes remain disabled. Enabling them requires the separately
# reviewed $0 Twelve Data account/API-key boundary and private non-display use only.
KALKI_PROSPECTIVE_OUTCOMES_ENABLED=false
KALKI_PROSPECTIVE_OUTCOMES_POLL_SECONDS=3600
KALKI_PROSPECTIVE_OUTCOMES_BATCH_SIZE=8
# KALKI_TWELVE_DATA_API_KEY_FILE=/absolute/path/outside-git
KALKI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# These portable system-service defaults match the primary installation guide.
# Replace them with /home/YOUR_USER/... paths only for a reviewed user-local install.
KALKI_OLLAMA_BIN=/usr/local/bin/ollama
KALKI_OLLAMA_LIB=/usr/local/lib/ollama
KALKI_OLLAMA_HOME=/usr/share/ollama/.ollama
# The development web interface remains disabled and loopback-only until explicitly enabled.
KALKI_WEB_ENABLED=false
KALKI_WEB_HOST=127.0.0.1
KALKI_WEB_PORT=8000
# Keep localhost for local-only use. Set one operator-controlled DNS hostname only
# when the separately reviewed optional public-tunnel deployment is intended.
KALKI_WEB_PUBLIC_HOSTNAME=localhost
KALKI_WEB_SECURE_COOKIES=false
KALKI_WEB_SESSION_IDLE_MINUTES=30
KALKI_WEB_SESSION_ABSOLUTE_HOURS=8
KALKI_WEB_LOGIN_ATTEMPTS=5
KALKI_WEB_LOGIN_WINDOW_SECONDS=300
KALKI_WEB_REQUEST_LIMIT=120
KALKI_WEB_REQUEST_WINDOW_SECONDS=60
KALKI_ADMIN_USERNAME=admin
# Generate locally with kalki-hash-admin-password; never put plaintext here.
# KALKI_ADMIN_PASSWORD_HASH='$argon2id$v=19$...'
# Production Compose injects database/admin/tunnel credentials from ignored files;
# never put those credentials in this file. See docs/PRODUCTION_DEPLOYMENT.md.
# Human research intake is enabled in production through compose configuration.
# Never place the Discord bot token here; it is mounted as a Docker secret.
KALKI_DISCORD_INTAKE_ENABLED=false
KALKI_DISCORD_INTAKE_BOT_TOKEN_FILE=/run/secrets/discord_intake_bot_token
# KALKI_DISCORD_INTAKE_CHANNEL_ID=YOUR_RESEARCH_CHANNEL_ID
# KALKI_DISCORD_INTAKE_RESULTS_CHANNEL_ID=YOUR_RESULTS_CHANNEL_ID
KALKI_DISCORD_INTAKE_ALLOWLIST=[]
# When enabling intake, replace the empty list with '["YOUR_ALLOWED_USER_ID"]'.
